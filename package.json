{
  "name": "@lyeve-labs/client",
  "version": "0.6.1",
  "description": "Framework-agnostic TypeScript SDK for the LyEve Core API",
  "license": "MIT",
  "author": "LyEve <info@lyeve.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyeve-labs/client.git"
  },
  "homepage": "https://github.com/lyeve-labs/client#readme",
  "bugs": {
    "url": "https://github.com/lyeve-labs/client/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "pnpm version:check && tsup && publint && node scripts/check-dist.mjs",
    "version:check": "node scripts/check-version.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
